---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import DocsNav from "../components/DocsNav.astro";
import { CATEGORY_ORDER, categoryOf, labelFor } from "../utils/categories";

function groupByCategory(docs: Awaited<ReturnType<typeof getCollection<"docs">>>) {
  const groups = new Map<string, typeof docs>();

  for (const doc of docs) {
    const category = categoryOf(doc.id);
    const group = groups.get(category) ?? [];
    group.push(doc);
    groups.set(category, group);
  }

  for (const group of groups.values()) {
    group.sort((a, b) => {
      if (a.id.endsWith("/index")) return -1;
      if (b.id.endsWith("/index")) return 1;
      return a.data.title.localeCompare(b.data.title);
    });
  }

  const orderedCategories = [
    ...CATEGORY_ORDER.filter((category) => groups.has(category)),
    ...[...groups.keys()].filter((category) => !CATEGORY_ORDER.includes(category)).sort(),
  ];

  return orderedCategories.map((category) => ({
    category,
    label: labelFor(category),
    docs: groups.get(category)!,
  }));
}

export async function getStaticPaths() {
  const docsEntries = await getCollection("docs");
  return docsEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, allDocs: docsEntries },
  }));
}

const { entry, allDocs } = Astro.props;
const { Content } = await render(entry);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const navGroups = groupByCategory(allDocs);

const currentGroup = navGroups.find(
  (group) => group.category === categoryOf(entry.id),
)!;
const currentIndex = currentGroup.docs.findIndex((doc) => doc.id === entry.id);
const prevDoc = currentIndex > 0 ? currentGroup.docs[currentIndex - 1] : null;
const nextDoc =
  currentIndex >= 0 && currentIndex < currentGroup.docs.length - 1
    ? currentGroup.docs[currentIndex + 1]
    : null;
---

<Layout title={entry.data.title} description={entry.data.description}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="lg:hidden mb-6">
      <button
        id="docs-drawer-open"
        type="button"
        class="flex w-full items-center justify-between gap-2 rounded-lg border border-zinc-200 dark:border-white/10 bg-zinc-50 dark:bg-white/5 px-4 py-2.5 text-sm font-medium text-zinc-700 dark:text-zinc-200"
      >
        <span class="flex items-center gap-2">
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5"></path></svg
          >
          Browse all articles
        </span>
        <span class="text-zinc-400 dark:text-zinc-500">{navGroups.reduce((n, g) => n + g.docs.length, 0)}</span>
      </button>
    </div>

    <dialog
      id="docs-drawer"
      class="m-0 h-dvh max-h-none w-full max-w-sm bg-white dark:bg-zinc-950 p-0 backdrop:bg-zinc-950/60 backdrop:backdrop-blur-sm open:animate-none"
    >
      <div class="flex h-full flex-col">
        <div
          class="flex items-center justify-between border-b border-zinc-200 dark:border-white/10 px-4 py-4"
        >
          <h3 class="font-semibold text-zinc-900 dark:text-white">
            Navigation
          </h3>
          <button
            id="docs-drawer-close"
            type="button"
            class="p-2 -mr-2 text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white"
            aria-label="Close navigation"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.75"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M6 18L18 6M6 6l12 12"></path></svg
            >
          </button>
        </div>
        <div class="flex-1 overflow-y-auto px-4 py-4">
          <DocsNav
            navGroups={navGroups}
            currentId={entry.id}
            base={base}
            instanceId="mobile"
          />
        </div>
      </div>
    </dialog>

    <div class="flex flex-col lg:flex-row gap-12">
      <aside class="hidden lg:block w-64 shrink-0">
        <nav class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto pr-2">
          <h3 class="font-semibold text-zinc-900 dark:text-white mb-4">
            Navigation
          </h3>
          <DocsNav
            navGroups={navGroups}
            currentId={entry.id}
            base={base}
            instanceId="desktop"
          />
        </nav>
      </aside>

      <div class="w-full max-w-3xl mx-auto lg:mx-0">
        <nav
          aria-label="Breadcrumb"
          class="mb-4 text-sm text-zinc-500 dark:text-zinc-400"
        >
          {
            currentGroup.docs[0]?.id.endsWith("/index") ? (
              <a
                href={`${base}/${currentGroup.docs[0].id}`}
                class="hover:text-zinc-900 dark:hover:text-white transition-colors"
              >
                {currentGroup.label}
              </a>
            ) : (
              <span>{currentGroup.label}</span>
            )
          }
        </nav>

        <article
          class="prose dark:prose-invert prose-zinc prose-a:text-emerald-500 dark:prose-a:text-emerald-400 prose-a:hover:text-emerald-600 dark:prose-a:hover:text-emerald-300 max-w-none"
        >
          <h1>{entry.data.title}</h1>
          <Content />
        </article>

        {
          (prevDoc || nextDoc) && (
            <nav
              aria-label="Article navigation"
              class="mt-12 grid grid-cols-1 sm:grid-cols-2 gap-4 border-t border-zinc-200 dark:border-white/10 pt-8"
            >
              {prevDoc ? (
                <a
                  href={`${base}/${prevDoc.id}`}
                  class="group rounded-lg border border-zinc-200 dark:border-white/10 p-4 hover:border-emerald-500/50 dark:hover:border-emerald-400/50 transition-colors"
                >
                  <span class="text-xs font-medium text-zinc-400 dark:text-zinc-500">
                    ← Previous
                  </span>
                  <p class="mt-1 text-sm font-semibold text-zinc-900 dark:text-white group-hover:text-emerald-500 dark:group-hover:text-emerald-400 transition-colors">
                    {prevDoc.data.title}
                  </p>
                </a>
              ) : (
                <div />
              )}
              {nextDoc && (
                <a
                  href={`${base}/${nextDoc.id}`}
                  class="group rounded-lg border border-zinc-200 dark:border-white/10 p-4 text-right hover:border-emerald-500/50 dark:hover:border-emerald-400/50 transition-colors sm:col-start-2"
                >
                  <span class="text-xs font-medium text-zinc-400 dark:text-zinc-500">
                    Next →
                  </span>
                  <p class="mt-1 text-sm font-semibold text-zinc-900 dark:text-white group-hover:text-emerald-500 dark:group-hover:text-emerald-400 transition-colors">
                    {nextDoc.data.title}
                  </p>
                </a>
              )}
            </nav>
          )
        }
      </div>
    </div>
  </div>
</Layout>

<style>
  #docs-drawer {
    position: fixed;
    inset: 0 auto 0 0;
    margin: 0;
  }
</style>

<script>
  const drawer = document.getElementById("docs-drawer") as HTMLDialogElement | null;
  const openBtn = document.getElementById("docs-drawer-open");
  const closeBtn = document.getElementById("docs-drawer-close");

  openBtn?.addEventListener("click", () => drawer?.showModal());
  closeBtn?.addEventListener("click", () => drawer?.close());
  drawer?.addEventListener("click", (event) => {
    if (event.target === drawer) drawer.close();
  });
</script>
