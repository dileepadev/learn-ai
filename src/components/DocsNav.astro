---
import type { CollectionEntry } from "astro:content";

interface NavGroup {
  category: string;
  label: string;
  docs: CollectionEntry<"docs">[];
}

interface Props {
  navGroups: NavGroup[];
  currentId: string;
  base: string;
  instanceId: string;
}

const { navGroups, currentId, base, instanceId } = Astro.props;
---

<div class="docs-nav" data-instance={instanceId}>
  <label class="relative block mb-4">
    <span class="sr-only">Search docs</span>
    <svg
      class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-zinc-400 dark:text-zinc-500"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
      ><path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M21 21l-4.35-4.35M17 10a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg
    >
    <input
      type="search"
      class="docs-nav-search w-full rounded-lg border border-zinc-200 dark:border-white/10 bg-zinc-50 dark:bg-white/5 py-2 pl-9 pr-3 text-sm text-zinc-900 dark:text-white placeholder:text-zinc-400 dark:placeholder:text-zinc-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/50"
      placeholder="Search articles..."
      autocomplete="off"
    />
  </label>

  <p class="docs-nav-empty hidden text-sm text-zinc-500 dark:text-zinc-400 mb-4">
    No articles match your search.
  </p>

  {
    navGroups.map((group) => (
      <div class="docs-nav-group mb-6" data-category={group.category}>
        <h4 class="text-xs font-semibold uppercase tracking-wide text-zinc-400 dark:text-zinc-500 mb-2">
          {group.label}
        </h4>
        <ul class="space-y-3 text-sm text-zinc-600 dark:text-zinc-400">
          {group.docs.map((doc) => (
            <li class="docs-nav-item" data-title={doc.data.title.toLowerCase()}>
              <a
                href={`${base}/${doc.id}`}
                class={`transition-colors ${currentId === doc.id ? "text-emerald-500 dark:text-emerald-400 font-semibold" : "hover:text-zinc-900 dark:hover:text-white"}`}
              >
                {doc.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<script>
  function initDocsNav(root: HTMLElement) {
    const input = root.querySelector<HTMLInputElement>(".docs-nav-search");
    const groups = root.querySelectorAll<HTMLElement>(".docs-nav-group");
    const items = root.querySelectorAll<HTMLElement>(".docs-nav-item");
    const emptyState = root.querySelector<HTMLElement>(".docs-nav-empty");

    input?.addEventListener("input", () => {
      const query = input.value.trim().toLowerCase();
      let anyVisible = false;

      groups.forEach((group) => {
        let groupHasMatch = false;

        group.querySelectorAll<HTMLElement>(".docs-nav-item").forEach((item) => {
          const matches = !query || (item.dataset.title ?? "").includes(query);
          item.classList.toggle("hidden", !matches);
          if (matches) groupHasMatch = true;
        });

        group.classList.toggle("hidden", !groupHasMatch);
        if (groupHasMatch) anyVisible = true;
      });

      emptyState?.classList.toggle("hidden", anyVisible || items.length === 0);
    });
  }

  document
    .querySelectorAll<HTMLElement>(".docs-nav")
    .forEach((root) => initDocsNav(root));
</script>
